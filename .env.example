# Modelo das variáveis de ambiente. NO SEU PC NÃO PRECISA DE NADA DISSO:
# sem .env o projeto usa SQLite e DEBUG ligado.
# Se quiser testar algo, copie este arquivo para ".env" (que não vai pro Git).

# Liga as mensagens de erro detalhadas. No servidor: False.
DEBUG=True

# Chave secreta. No servidor o Render gera uma sozinha.
SECRET_KEY=

# Banco. Vazio = SQLite (db.sqlite3). No Render: a connection string do Neon, assim:
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Sites extras que podem chamar a API (separados por vírgula).
# localhost:8443 e as URLs *.vercel.app do se-educa-front já são liberadas no settings.py.
CORS_ALLOWED_ORIGINS=

# Endereços extras em que a API responde (o do Render já entra sozinho).
ALLOWED_HOSTS=

# Usado só no Render, pelo build.sh, para criar o superusuário do admin.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
